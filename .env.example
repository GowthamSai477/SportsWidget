# ---- Core ----
NODE_ENV=development
PORT=3000
# DEVELOPMENT_MODE=true grants every entitlement (spec section 80).
# NEVER deploy to production with this flag on.
DEVELOPMENT_MODE=true

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://widgets:widgets_dev_pw@localhost:5432/widgets?schema=public

# ---- Cache / Queues (Redis) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=change-me-in-real-environments-min-32-chars-long!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Sports providers (backend only; never ship to the mobile app) ----
JOLPICA_F1_BASE_URL=https://api.jolpi.ca/ergast/f1
# Future providers:
# SPORTMONKS_CRICKET_API_KEY=
# SPORTMONKS_FOOTBALL_API_KEY=

# ---- Auth providers (Milestone 18; public client IDs only in mobile) ----
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ---- Observability ----
SENTRY_DSN=

# ---- Mobile app (baked into client bundle at build time) ----
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
